+/// Every place in `code`, as offsets from its start, where one of the
+/// prologues of `target` opens, in order.
+pub(crate) fn places(target: &Target, code: &[u8]) -> Vec<usize> {
+    let mut places: Vec<usize> = target
+        .patterns()
